---
// 05 · A Bia (osso). Gesto: retrato numa janela alta e estreita à esquerda, texto em coluna
// e o vídeo da série numa janela vertical que desce sobre a borda inferior do retrato.
import Provisorio from '../Provisorio.astro';
import Janela from '../brand/Janela.astro';
import Legenda from '../ui/Legenda.astro';
import { imagemDoSlot } from '../hero/midia.ts';
import { biaTexto, nomeBia } from './conteudo.ts';
import { imagemJanela, videoDoItem } from './midia.ts';

const retrato = imagemDoSlot('sobre.retrato');
const video = videoDoItem('mulheres-transformadas-com-bia');
const consulta = biaTexto.consulta;
---

<section id="bia" class="bia" data-tone="light" aria-labelledby="bia-titulo">
  <div class="recipiente bia__grade">
    <div class="bia__retrato">
      <Janela
        forma="alta"
        classeMidia="tratamento-retrato"
        {...(retrato && {
          imagem: imagemJanela(
            retrato,
            '(min-width: 900px) 30vw, 70vw',
            `${nomeBia}, fisioterapeuta, em retrato de estúdio`,
          ),
        })}
        placeholder="retrato da Bia"
      />
    </div>

    <div class="bia__texto">
      <Legenda numero={5}>{biaTexto.legenda}</Legenda>
      <h2 id="bia-titulo" class="bia__titulo t-2">
        {biaTexto.titulo}
      </h2>
      <p class="bia__credencial">{biaTexto.credencial}</p>
      <p class="bia__corpo">{biaTexto.texto}</p>
      <div class="bia__acoes">
        <a class="botao" href={biaTexto.botao.href}>
          {biaTexto.botao.rotulo}
        </a>
        <Provisorio campo={consulta}>
          <a class="bia__consulta" href={consulta.valor ?? '#'} rel="noopener" target="_blank">
            {consulta.rotulo}
            <span class="so-leitor"> (abre em nova aba)</span>
          </a>
        </Provisorio>
      </div>
    </div>

    <div class="bia__video">
      <Janela
        forma="baixa"
        {...(video && {
          video: { ...video, rotulo: biaTexto.rotuloVideo },
        })}
        placeholder="vídeo da série"
      >
        <figcaption class="bia__legenda-video">Da série em vídeo · clique para assistir</figcaption>
      </Janela>
    </div>
  </div>
</section>

<style>
  .bia {
    padding-block: var(--secao-y) calc(var(--secao-y) * 1.2);
  }
  .bia__grade {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--e-5);
    row-gap: var(--e-7);
  }
  .bia__retrato {
    grid-column: 1 / 10;
  }
  .bia__texto {
    grid-column: 1 / -1;
    display: grid;
    align-content: start;
    gap: var(--e-5);
  }
  .bia__titulo {
    max-width: 16ch;
  }
  .bia__credencial {
    margin: 0;
    font-size: var(--t-legenda);
    font-weight: 600;
    letter-spacing: var(--tracking-legenda);
    text-transform: uppercase;
  }
  .bia__corpo {
    margin: 0;
    color: var(--fg-suave);
  }
  .bia__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-5);
  }
  .bia__consulta {
    font-size: var(--t-pequeno);
  }
  .bia__video {
    grid-column: 4 / -1;
    justify-self: end;
    width: min(100%, 15rem);
  }
  .bia__legenda-video {
    margin-block-start: var(--e-3);
    font-size: var(--t-legenda);
    letter-spacing: var(--tracking-legenda);
    text-transform: uppercase;
    color: var(--fg-suave);
  }
  @media (min-width: 900px) {
    .bia__retrato {
      grid-column: 1 / 5;
      grid-row: 1 / 3;
    }
    .bia__texto {
      grid-column: 6 / 12;
      grid-row: 1;
      padding-block-start: var(--e-8);
    }
    .bia__video {
      grid-column: 4 / 7;
      grid-row: 2;
      justify-self: start;
      width: 100%;
      max-width: 16rem;
      margin-block-start: -9rem;
      position: relative;
      z-index: 1;
    }
  }
</style>
