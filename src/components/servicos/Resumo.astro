---
// Resumo citável (40–60 palavras) num parágrafo só; se começa pela abertura, ela vira o "lead"
// em display dentro do mesmo parágrafo (sem repetir a frase).
interface Props {
  abertura: string;
  resumo: string;
  classe?: string;
}
const { abertura, resumo, classe } = Astro.props;
const junto = resumo.startsWith(abertura);
const resto = junto ? resumo.slice(abertura.length).trim() : resumo;
---

{junto ? (
  <p class:list={['resumo', classe]} data-resumo>
    <span class="resumo__lead">{abertura}</span> {resto}
  </p>
) : (
  <>
    <p class:list={['resumo__lead', 'resumo__solta', classe]}>{abertura}</p>
    <p class:list={['resumo', classe]} data-resumo>
      {resumo}
    </p>
  </>
)}

<style>
  .resumo {
    margin: 0;
    max-width: 36rem;
  }
  .resumo__lead {
    display: block;
    margin-block-end: var(--e-4);
    font-family: var(--f-display);
    font-size: var(--t-4);
    font-style: italic;
    line-height: 1.3;
  }
  .resumo__solta {
    margin: 0;
    max-width: 36rem;
  }
</style>
