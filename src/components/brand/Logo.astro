---
// Logo B (vetor extraído do logo; PROVISÓRIO enquanto a origem for raster).
// variante "monograma": só o B · "completo": B + nome da marca em texto (não é um logotipo novo).
import { pathB, viewBoxB } from './marca.ts';

interface Props {
  variante?: 'monograma' | 'completo';
  altura?: string;
  rotulo?: string;
  class?: string;
}

const {
  variante = 'monograma',
  altura = '2.5rem',
  rotulo = 'Espaço B',
  class: classe,
} = Astro.props;
---

<span class:list={['logo', `logo--${variante}`, classe]} style={`--logo-altura:${altura}`}>
  <svg
    viewBox={viewBoxB}
    role="img"
    aria-label={variante === 'monograma' ? rotulo : undefined}
    aria-hidden={variante === 'completo' ? 'true' : undefined}
    focusable="false"
  >
    <path fill="currentColor" fill-rule="evenodd" d={pathB}></path>
  </svg>
  {variante === 'completo' && <span class="logo__nome">{rotulo}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    color: inherit;
    line-height: 1;
  }
  svg {
    height: var(--logo-altura);
    width: auto;
  }
  .logo__nome {
    font-family: var(--f-display);
    font-size: calc(var(--logo-altura) * 0.5);
    letter-spacing: 0.01em;
  }
</style>
