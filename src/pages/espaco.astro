---
// /espaco (sessão 6C).
import Espaco from '../components/paginas/Espaco.astro';
import NavServicos from '../components/servicos/NavServicos.astro';
import Transicoes from '../components/servicos/Transicoes.astro';
import Header from '../components/ui/Header.astro';
import { marca } from '../config/marca.ts';
import Base from '../layouts/Base.astro';
import { espacoPagina } from '../components/paginas/conteudo.ts';
---

<Base descricao={espacoPagina.texto} titulo={`O espaço · ${marca.nomeCurto.valor}`}>
  <Transicoes slot="head" />
  <Header slot="header" tomInicial="moss">
    <NavServicos />
  </Header>
  <Espaco />
</Base>
