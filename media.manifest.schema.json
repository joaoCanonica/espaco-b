{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "media.manifest.schema.json",
  "title": "Manifesto de mídia — Espaço B",
  "type": "object",
  "required": ["versao", "atualizadoEm", "musgoOficial", "itens"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "versao": {
      "const": 1
    },
    "atualizadoEm": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "musgoOficial": {
      "type": "object",
      "required": ["hex", "fonte", "metodo"],
      "properties": {
        "hex": {
          "$ref": "#/definitions/hex"
        }
      }
    },
    "itens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/item"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    },
    "pacienteRef": {
      "type": "string",
      "pattern": "^P-\\d{3}$"
    },
    "consentimento": {
      "enum": [
        "titular",
        "paciente-termo",
        "declarado-pelo-cliente",
        "nenhum",
        "nenhum-necessario",
        "terceiros"
      ]
    },
    "intervalo": {
      "type": "object",
      "required": ["ini", "fim"],
      "properties": {
        "ini": {
          "type": "number",
          "minimum": 0
        },
        "fim": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "segmento": {
      "allOf": [
        {
          "$ref": "#/definitions/intervalo"
        }
      ],
      "type": "object",
      "required": ["ini", "fim", "conteudo", "usar", "motivo"],
      "properties": {
        "ini": true,
        "fim": true,
        "conteudo": {
          "type": "string",
          "minLength": 3
        },
        "usar": {
          "type": "boolean"
        },
        "motivo": {
          "type": "string",
          "minLength": 3
        },
        "problemas": {
          "type": "string"
        },
        "pacienteRef": {
          "$ref": "#/definitions/pacienteRef"
        },
        "consentimento": {
          "$ref": "#/definitions/consentimento"
        },
        "naoUsarComoCapa": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "if": {
        "required": ["pacienteRef"]
      },
      "then": {
        "required": ["consentimento", "naoUsarComoCapa"],
        "properties": {
          "naoUsarComoCapa": {
            "const": true
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "arquivo",
        "tipo",
        "origem",
        "autoria",
        "consentimento",
        "publicavel",
        "previewOk",
        "dataRegistro",
        "pacienteRef",
        "menorDeIdade",
        "naoUsarComoCapa",
        "uso",
        "decisao",
        "tecnico",
        "edicoes",
        "trim",
        "problemas"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "not": {
            "pattern": "(monjaro|mounjaro|monjauro|ozempic|wegovy|saxenda|tirzepatida|semaglutida|liraglutida)"
          }
        },
        "arquivo": {
          "type": "string"
        },
        "tipo": {
          "enum": ["imagem", "video", "marca"]
        },
        "origem": {
          "enum": ["real", "gerada-por-ia"]
        },
        "autoria": {
          "type": "string",
          "minLength": 3
        },
        "consentimento": {
          "$ref": "#/definitions/consentimento"
        },
        "termoArquivado": {
          "type": "boolean"
        },
        "publicavel": {
          "type": "boolean"
        },
        "previewOk": {
          "type": "boolean"
        },
        "substituida": {
          "type": "boolean"
        },
        "substituidaPor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prioridade": {
          "enum": ["alta", "normal", "baixa"]
        },
        "dataRegistro": {
          "type": ["string", "null"]
        },
        "pacienteRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/pacienteRef"
            }
          ]
        },
        "pacienteRefs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pacienteRef"
          },
          "uniqueItems": true
        },
        "menorDeIdade": {
          "type": "boolean"
        },
        "naoUsarComoCapa": {
          "type": "boolean"
        },
        "uso": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisao": {
          "type": "string"
        },
        "perfil": {
          "enum": ["ambiente", "mudo", "clique"]
        },
        "audio": {
          "type": "boolean"
        },
        "flagFinal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tecnico": {
          "type": "object",
          "required": ["largura", "altura", "bytes", "formato", "sha256"],
          "properties": {
            "largura": {
              "type": "integer",
              "minimum": 1
            },
            "altura": {
              "type": "integer",
              "minimum": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "formato": {
              "type": "string"
            },
            "duracao": {
              "type": "number"
            },
            "codec": {
              "type": "string"
            },
            "fps": {
              "type": "number"
            },
            "audioOriginal": {
              "type": "string"
            },
            "proporcao": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "corMedia": {
          "$ref": "#/definitions/hex"
        },
        "corFundo": {
          "type": "object"
        },
        "objectPosition": {
          "type": "string",
          "pattern": "^\\d{1,3}% \\d{1,3}%$"
        },
        "recortes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nome", "proporcao", "objectPosition"],
            "properties": {
              "nome": {
                "type": "string"
              },
              "proporcao": {
                "type": "string",
                "pattern": "^\\d+:\\d+$"
              },
              "objectPosition": {
                "type": "string",
                "pattern": "^\\d{1,3}% \\d{1,3}%$"
              }
            }
          }
        },
        "ajusteCorPlanejado": {
          "type": "string"
        },
        "ladrilhavel": {
          "type": "object",
          "required": ["resultado", "teste"]
        },
        "legendaQueimada": {
          "type": "object",
          "required": ["texto", "zona"],
          "properties": {
            "zona": {
              "type": "object",
              "required": ["topo", "base"],
              "properties": {
                "topo": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "base": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "poster": {
          "type": "object",
          "required": ["t", "observacao"],
          "properties": {
            "t": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "segmentos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/segmento"
          }
        },
        "clipes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "ini", "fim"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "ini": {
                "type": "number"
              },
              "fim": {
                "type": "number"
              },
              "pacienteRef": {
                "$ref": "#/definitions/pacienteRef"
              }
            }
          }
        },
        "edicoes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trim": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/definitions/intervalo"
              }
            ],
            "required": ["motivo"]
          }
        },
        "problemas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "consentimento": {
                "const": "nenhum"
              }
            },
            "required": ["consentimento"]
          },
          "then": {
            "properties": {
              "publicavel": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "consentimento": {
                "const": "terceiros"
              }
            },
            "required": ["consentimento"]
          },
          "then": {
            "properties": {
              "publicavel": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "menorDeIdade": {
                "const": true
              }
            },
            "required": ["menorDeIdade"]
          },
          "then": {
            "properties": {
              "publicavel": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pacienteRef": {
                "type": "string"
              }
            },
            "required": ["pacienteRef"]
          },
          "then": {
            "required": ["termoArquivado"],
            "properties": {
              "naoUsarComoCapa": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "required": ["pacienteRefs"],
            "properties": {
              "pacienteRefs": {
                "minItems": 1
              }
            }
          },
          "then": {
            "required": ["termoArquivado"],
            "properties": {
              "naoUsarComoCapa": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "video"
              }
            },
            "required": ["tipo"]
          },
          "then": {
            "required": ["segmentos", "poster", "perfil", "audio", "legendaQueimada"]
          }
        },
        {
          "if": {
            "properties": {
              "substituida": {
                "const": true
              }
            },
            "required": ["substituida"]
          },
          "then": {
            "properties": {
              "publicavel": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
